<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KDAA-AI Portfolio — {{ run.unit.name|e }}</title>
  <style>
    :root { --ink:#17202a; --muted:#59636e; --line:#dce1e7; --panel:#f7f9fb; --accent:#1f5c82; --warn:#8a4b08; }
    body { margin:0; font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color:var(--ink); background:white; }
    main { max-width:1100px; margin:0 auto; padding:38px 28px 64px; }
    h1 { margin:0 0 8px; font-size:2rem; }
    h2 { margin-top:42px; padding-bottom:8px; border-bottom:1px solid var(--line); }
    h3 { margin-top:30px; }
    .meta, .muted { color:var(--muted); }
    .notice { background:#fff8eb; border-left:5px solid #d88a22; padding:14px 16px; margin:22px 0; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; }
    .metric, .card { border:1px solid var(--line); border-radius:10px; padding:15px; background:var(--panel); }
    .metric strong { display:block; font-size:1.5rem; color:var(--accent); }
    .badge { display:inline-block; border:1px solid var(--line); border-radius:999px; padding:3px 8px; margin:2px 3px 2px 0; font-size:.82rem; background:white; }
    table { border-collapse:collapse; width:100%; }
    th, td { border-bottom:1px solid var(--line); padding:8px; text-align:left; vertical-align:top; }
    th { background:var(--panel); }
    code { background:#eef2f5; padding:2px 5px; border-radius:4px; }
    ul { line-height:1.45; }
    .score { font-variant-numeric:tabular-nums; }
  </style>
</head>
<body><main>
  <h1>KDAA-AI Knowledge Asset Portfolio</h1>
  <div class="meta">{{ run.unit.name|e }} · {{ run.unit.unit_type.value|e }} · {{ run.manifest.created_at.isoformat()|e }}</div>
  <div class="notice"><strong>Epistemic status:</strong> system-generated hypotheses and provisional records are not confirmed expertise or ownership claims.</div>
  <div class="grid">
    <div class="metric"><strong>{{ run.traces|length }}</strong>evidence traces</div>
    <div class="metric"><strong>{{ run.assets|length }}</strong>asset records</div>
    <div class="metric"><strong>{{ run.confirmed_assets|length }}</strong>confirmed assets</div>
    <div class="metric"><strong>{{ run.opportunities|length }}</strong>opportunities</div>
  </div>

  <h2>Provisional asset portfolio</h2>
  {% for asset in run.assets %}
  <section class="card">
    <h3>{{ loop.index }}. {{ asset.label|e }}</h3>
    <p>{{ asset.bounded_claim|e }}</p>
    <p><span class="badge">{{ asset.epistemic_state.value|e }}</span>
    {% for category in asset.categories %}<span class="badge">{{ category.value|e }}</span>{% endfor %}</p>
    {% if asset.assessment %}
    <p class="score"><strong>Credibility</strong> {{ '%.2f'|format(asset.assessment.overall_credibility.value) }} ·
       <strong>Tacitness</strong> {{ '%.2f'|format(asset.assessment.tacitness.value) }} ·
       <strong>Transferability</strong> {{ '%.2f'|format(asset.assessment.transferability.value) }} ·
       <strong>AI interfaceability</strong> {{ '%.2f'|format(asset.assessment.ai_interfaceability.value) }}</p>
    {% endif %}
    <p><strong>Supporting trace IDs:</strong> {{ asset.evidence_links|selectattr('role.value', 'equalto', 'supporting')|map(attribute='trace_id')|join(', ')|e }}</p>
  </section>
  {% endfor %}

  <h2>Candidate amplification opportunities</h2>
  {% for opportunity in run.opportunities %}
  <section class="card">
    <h3>{{ loop.index }}. {{ opportunity.title|e }}</h3>
    <p><span class="badge">{{ opportunity.output_container.value|e }}</span>
       <span class="badge">priority {{ '%.2f'|format(opportunity.priority_score) }}</span>
       <span class="badge">risk {{ '%.2f'|format(opportunity.governance_risk) }}</span></p>
    <p>{{ opportunity.problem|e }}</p>
    <p><strong>Baseline:</strong> {{ opportunity.credible_baseline|e }}</p>
    <p><strong>Verification:</strong></p><ul>{% for item in opportunity.verification_gates %}<li>{{ item|e }}</li>{% endfor %}</ul>
  </section>
  {% endfor %}

  <h2>Warnings and scope limits</h2>
  <ul>{% for warning in run.warnings %}<li>{{ warning|e }}</li>{% endfor %}</ul>
  <p class="muted">Run <code>{{ run.manifest.run_id|e }}</code> · config <code>{{ run.manifest.config_digest|e }}</code> · input <code>{{ run.manifest.input_digest|e }}</code></p>
</main></body></html>
