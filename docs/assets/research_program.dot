digraph Program {
  graph [
    rankdir=LR,
    bgcolor="#FFFFFF",
    pad="0.20",
    nodesep="0.55",
    ranksep="0.65",
    splines=spline,
    fontname="Helvetica",
    fontsize=14,
    label="KDAA research program: distinct but cumulative papers",
    labelloc=t,
    labeljust=l
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, margin="0.14,0.10", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=9, color="#64748B", penwidth=1.2, arrowsize=0.75];

  A [label="Paper A — DEFINE\nTheory of AI-amplified knowledge assets\nConstructs • mechanisms • propositions\nCurrent 30-page manuscript is the scaffold", fillcolor="#EFF6FF", color="#2563EB"];
  B [label="Paper B — BUILD\nTheory-grounded intelligent system\nArchitecture • repo • baselines • ablations\nThis repository is the primary artifact", fillcolor="#FFF7ED", color="#EA580C"];
  C [label="Paper C — TEST WITH HUMANS\nCalibration • acceptance • novelty • outcomes\nRealized/captured value • longitudinal learning\nNot a prerequisite for v0.1", fillcolor="#F0FDF4", color="#16A34A"];

  A -> B [label="constructs become\nrequirements and schema"];
  B -> A [label="implementation exposes\nweak or redundant constructs", constraint=false, color="#8B5CF6", fontcolor="#6D28D9"];
  B -> C [label="artifact becomes\nresearch instrument"];
  C -> A [label="evidence revises theory", constraint=false, style=dashed, color="#CA8A04", fontcolor="#854D0E"];
}
